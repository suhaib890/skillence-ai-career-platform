# Leave DATABASE_URL unset to use a local SQLite file (zero-setup).
# For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://skillence:skillence@localhost:5432/skillence
# For Supabase on Render, use the Session pooler URL, not db.<project-ref>.supabase.co:
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_URL=

# Comma-separated allowed CORS origins. In production set this to your frontend URL,
# e.g. https://skillence.netlify.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Path to trained model artifacts (defaults to ../models)
# MODELS_DIR=

# ---- Admin portal / RBAC ----
# Bootstrap admin login (used to create/upgrade the admin account).
ADMIN_EMAIL=khanauj60@gmail.com
ADMIN_PASSWORD=Auj@12110
# HMAC secret for signing session tokens. MUST be a strong random value in production.
AUTH_SECRET=change-me-to-a-long-random-string
AUTH_TOKEN_TTL_HOURS=24

# ---- Optional LLM enhancement (Transition / Interview) ----
# Leave LLM_API_KEY empty to use the deterministic engine (no external calls).
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-4-5-20251001
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=20
